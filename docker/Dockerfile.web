# DPanel + 移动端 UI（本仓库前端替换版）— 单架构 amd64 简化构建
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache gcc musl-dev make git bash ca-certificates linux-headers
ENV GOPROXY=https://goproxy.cn,direct
WORKDIR /src

COPY go.mod go.sum ./
COPY app/agent/go.mod app/agent/go.sum ./app/agent/
RUN go mod download

COPY ./ /src

ARG APP_VERSION=2.0.0-ui
RUN CGO_ENABLED=1 GOTOOLCHAIN=local go build -trimpath -tags "lite,w7_rangine_release,containers_image_openpgp" -ldflags "-s -w -X main.DPanelVersion=${APP_VERSION}" -o ./runtime/dpanel . \
    && chmod +x ./runtime/dpanel

FROM alpine:3.21

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.ustc.edu.cn/g' /etc/apk/repositories \
    && apk add --no-cache --update bash musl docker-cli docker-cli-compose docker-cli-buildx tzdata git openssh-client curl \
    && rm -f /usr/bin/docker-compose \
    && mkdir -p /root/.ssh && chmod 700 /root/.ssh

WORKDIR /app/server

ENV TZ=Asia/Shanghai
ENV PATH="/app/server:${PATH}"
ENV DOCKER_HOST=unix:///var/run/docker.sock
ENV DP_SYSTEM_STORAGE_LOCAL_PATH=/dpanel
ENV DP_DB_DATABASE=/dpanel/dpanel.db
ENV DP_ACME_CONFIG_HOME=/dpanel/acme
ENV DP_RUN_IN_CONTAINER=1
ENV APP_NAME=dpanel
ENV APP_SERVER_PORT=8080
ENV APP_VERSION=2.0.0-ui
ENV APP_ENV=lite
ENV DOCKER_CONFIG=/dpanel/buildx

VOLUME [ "/dpanel" ]

COPY --from=builder /src/runtime/dpanel /app/server/dpanel
COPY ./config.yaml /app/server/config.yaml
COPY ./docker/script /app/script
COPY ./docker/task /docker

RUN chmod -R 755 /docker/* /app/server/dpanel \
    && sed -i 's/\r$//' /docker/entrypoint-lite.sh /app/server/config.yaml /app/script/*.sh 2>/dev/null || true

EXPOSE 8080
ENTRYPOINT [ "/docker/entrypoint-lite.sh" ]

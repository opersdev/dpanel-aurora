# DPanel Aurora — 仅维护前端
# 直接 FROM 官方镜像 dpanel/dpanel:lite：不拉后端源码、不编译 Go。
# 官方后端挪到 8086 端口；nginx 监听 8080，对外提供本仓库前端（ui-source），
# 并把 /dpanel/api、/dpanel/ws 反代给容器内的官方后端。
# 如需锁定官方版本：--build-arg DPANEL_IMAGE=dpanel/dpanel:v2.5.1-lite
ARG DPANEL_IMAGE=dpanel/dpanel:lite
FROM ${DPANEL_IMAGE}

USER root

# 官方后端让出 8080 给 nginx 入口（前端 + 反向代理）
ENV APP_SERVER_PORT=8086

# 国内构建拉不动基础镜像时：--build-arg DPANEL_IMAGE=docker.m.daocloud.io/dpanel/dpanel:lite
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.ustc.edu.cn/g' /etc/apk/repositories \
    && apk add --no-cache nginx

COPY ui-source/ /app/ui/
COPY docker/nginx-ui.conf /etc/nginx/http.d/dpanel-ui.conf
COPY docker/start.sh /app/start.sh

RUN chmod +x /app/start.sh \
    && sed -i 's/\r$//' /app/start.sh /etc/nginx/http.d/dpanel-ui.conf

EXPOSE 8080
ENTRYPOINT [ "/app/start.sh" ]
